# cp .env.example .env  — then fill these in.
# This same file works for Windows CPU testing and Linux GPU servers.

# IP of the central dockprom monitoring server
MAIN_SERVER_IP=YOUR_MAIN_SERVER_IP_HERE

# Unique name for this remote machine.
# Use this same value for every monitoring agent running on this machine.
SERVER_ID=gpu-server-1

# Optional. Linux NVIDIA GPU only.
# start.sh auto-detects this when possible. Set manually only if auto-detect
# picks the wrong file.
# NVIDIA_ML_LIB_PATH=/usr/lib/x86_64-linux-gnu/libnvidia-ml.so.550.90.07
